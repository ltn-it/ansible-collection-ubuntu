"""Read-only Root installation preflight/readback; no service activation."""
import grp
import hashlib
import json
import math
import os
from pathlib import PurePosixPath
import pwd
import re
import stat
import subprocess
import sys

PRIVATE = "/usr/local/lib/lit-incus-runtime-v2"
PUBLIC = "/usr/libexec/lightning-it"
SOCKET = "/run/lightning-it/incus-runtime-v2/socket"
# Canonical full qualification, including the independently validated predecessor
# chain, provider graph, bank identity, catalogues and all retirement receipts.
NINTH_RETIREMENT_SHA256 = "0c6dd360dcb6c2bdfd3fa9f1cd6a74bf43b4c6361daab26b293ac484d228ba3e"
SHA = re.compile(r"[0-9a-f]{64}\Z")


def require(value):
    if not value:
        raise ValueError("runtime-v2-installation-denied")


def pairs(values):
    result = {}
    for key, value in values:
        require(key not in result)
        result[key] = value
    return result


def finite(value):
    result = float(value)
    require(math.isfinite(result))
    return result


def decode(raw):
    return json.loads(raw, object_pairs_hook=pairs, parse_float=finite,
                      parse_constant=lambda _: require(False))


def directory(path, missing=False):
    require(type(path) is str and path.startswith("/") and str(PurePosixPath(path)) == path
            and ".." not in PurePosixPath(path).parts)
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for name in PurePosixPath(path).parts[1:]:
            try:
                following = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            except FileNotFoundError:
                require(missing)
                return None
            os.close(fd)
            fd = following
            info = os.fstat(fd)
            require(info.st_uid == 0 and not info.st_mode & 0o022)
        result, fd = fd, -1
        return result
    finally:
        if fd >= 0:
            os.close(fd)


def sealed(path, expected=None, private=True):
    parent = directory(str(PurePosixPath(path).parent))
    try:
        fd = os.open(PurePosixPath(path).name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)
        try:
            before = os.fstat(fd)
            require(stat.S_ISREG(before.st_mode) and before.st_uid == 0 and before.st_nlink == 1
                    and not before.st_mode & 0o022 and before.st_size <= 8*1024*1024
                    and (not private or stat.S_IMODE(before.st_mode) == 0o600))
            raw = bytearray()
            while True:
                part = os.read(fd, 65536)
                if not part:
                    break
                raw.extend(part)
                require(len(raw) <= 8*1024*1024)
            after = os.fstat(fd)
            require((before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns,before.st_ctime_ns)
                    == (after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns,after.st_ctime_ns))
            require(expected is None or SHA.fullmatch(expected) and hashlib.sha256(raw).hexdigest() == expected)
            return bytes(raw)
        finally:
            os.close(fd)
    finally:
        os.close(parent)


def private_metadata(path):
    """Check the existing signer without reading, hashing or exporting its bytes."""
    parent = directory(str(PurePosixPath(path).parent))
    try:
        fd = os.open(PurePosixPath(path).name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)
        try:
            info = os.fstat(fd)
            require(stat.S_ISREG(info.st_mode) and info.st_uid == 0 and info.st_nlink == 1
                    and stat.S_IMODE(info.st_mode) == 0o600 and 0 < info.st_size <= 16384)
            return info.st_dev, info.st_ino, info.st_size
        finally:
            os.close(fd)
    finally:
        os.close(parent)


def state(unit, expected=None):
    if expected is not None:
        return historical_state(unit, expected)
    template = "lit-incus-runtime-v2@.service"
    query = "lit-incus-runtime-v2@installation-probe.service" if unit == template else unit
    fragment = template if query.startswith("lit-incus-runtime-v2@") and query.endswith(".service") else unit
    result = subprocess.run(["/usr/bin/systemctl", "show", "--no-pager", query,
        "--property=LoadState,ActiveState,SubState,UnitFileState,FragmentPath,DropInPaths"],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        env={"PATH":"/usr/bin:/bin","LANG":"C"}, timeout=5, check=False)
    require(result.returncode in {0,1} and len(result.stdout) <= 16384)
    values = dict(line.split("=",1) for line in result.stdout.decode("utf-8").splitlines())
    require(set(values) == {"LoadState","ActiveState","SubState","UnitFileState","FragmentPath","DropInPaths"})
    require(values["DropInPaths"] == "" and values["ActiveState"] == "inactive" and values["SubState"] == "dead")
    if values["LoadState"] == "not-found":
        require(values["UnitFileState"] == values["FragmentPath"] == "")
    else:
        require(values["LoadState"] == "loaded" and values["UnitFileState"] in {"disabled","static"}
                and values["FragmentPath"] == "/etc/systemd/system/"+fragment)


HISTORY_PROPERTIES = frozenset({"Id", "LoadState", "ActiveState", "SubState", "UnitFileState", "FragmentPath",
    "DropInPaths", "InvocationID", "Result", "ExecMainCode", "ExecMainStatus", "MainPID", "ControlPID",
    "ControlGroup", "Slice", "Job"})
HISTORY_UNIT = re.compile(r"lit-incus-runtime-v2@[0-9]+-[0-9]+-[0-9]+\.service\Z")
HISTORY_SLICE = "system-lit\\x2dincus\\x2druntime\\x2dv2.slice"


def boot_id():
    fd = os.open("/proc/sys/kernel/random/boot_id", os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        require(os.fstat(fd).st_uid == 0)
        return os.read(fd, 128).decode("ascii").strip()
    finally:
        os.close(fd)


def terminal_history(value):
    """Explicit Root-supplied nonsecret snapshot; never discover or adopt failed units."""
    require(type(value) is dict)
    if not value:
        return {}
    require(set(value) == {"schema", "source_machine_id", "source_boot_id", "units"}
            and type(value["schema"]) is int and value["schema"] == 1
            and type(value["source_machine_id"]) is str
            and re.fullmatch(r"[0-9a-f]{32}", value["source_machine_id"])
            and value["source_machine_id"] != "0" * 32
            and type(value["source_boot_id"]) is str
            and re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", value["source_boot_id"])
            and value["source_boot_id"] != "00000000-0000-0000-0000-000000000000"
            and type(value["units"]) is dict and 1 <= len(value["units"]) <= 32)
    require(value["source_machine_id"] == sealed("/etc/machine-id", private=False).decode("ascii").strip()
            and value["source_boot_id"] == boot_id())
    invocations = set()
    for unit, row in value["units"].items():
        require(type(unit) is str and len(unit) <= 255 and HISTORY_UNIT.fullmatch(unit)
                and type(row) is dict and set(row) == HISTORY_PROPERTIES | {"cgroup_state"}
                and all(type(item) is str and len(item) <= 4096 for item in row.values()))
        require(row["Id"] == unit and row["LoadState"] == "loaded"
                and row["ActiveState"] == row["SubState"] == "failed"
                and row["UnitFileState"] in {"static", "disabled"}
                and row["FragmentPath"] == "/etc/systemd/system/lit-incus-runtime-v2@.service"
                and row["DropInPaths"] == row["Job"] == ""
                and row["MainPID"] == row["ControlPID"] == "0"
                and row["Result"] == "exit-code" and row["ExecMainCode"] == "1"
                and re.fullmatch(r"[1-9][0-9]{0,2}", row["ExecMainStatus"]) and int(row["ExecMainStatus"]) <= 255
                and re.fullmatch(r"[0-9a-f]{32}", row["InvocationID"]) and row["InvocationID"] != "0" * 32
                and row["InvocationID"] not in invocations and row["Slice"] == HISTORY_SLICE
                and row["cgroup_state"] in {"absent", "empty"})
        group = "/system.slice/" + HISTORY_SLICE + "/" + unit
        require(row["ControlGroup"] in {"", group}
                and (row["cgroup_state"] != "absent" or row["ControlGroup"] == ""))
        invocations.add(row["InvocationID"])
    return value["units"]


def cgroup_state(unit):
    """Only the exact template-instance cgroup, including descendants; never a ledger."""
    root = directory("/sys/fs/cgroup")
    os.close(root)
    fd = directory("/sys/fs/cgroup/system.slice/" + HISTORY_SLICE + "/" + unit, missing=True)
    if fd is None:
        return "absent"
    try:
        files = {}
        for name in ("cgroup.procs", "cgroup.events"):
            child = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            try:
                info = os.fstat(child)
                require(stat.S_ISREG(info.st_mode) and info.st_uid == 0)
                raw = os.read(child, 16385)
                require(len(raw) <= 16384)
                files[name] = raw.decode("ascii")
            finally:
                os.close(child)
        events = pairs(line.split() for line in files["cgroup.events"].splitlines())
        require(not files["cgroup.procs"].strip() and events == {"populated": "0", "frozen": "0"})
        return "empty"
    finally:
        os.close(fd)


def historical_state(unit, expected):
    result = subprocess.run(["/usr/bin/systemctl", "show", "--no-pager", unit,
        "--property=" + ",".join(sorted(HISTORY_PROPERTIES))],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        env={"PATH": "/usr/bin:/bin", "LANG": "C"}, timeout=5, check=False)
    require(result.returncode == 0 and len(result.stdout) <= 16384)
    values = pairs(line.split("=", 1) for line in result.stdout.decode("utf-8").splitlines())
    require(set(values) == HISTORY_PROPERTIES and values == {key: expected[key] for key in HISTORY_PROPERTIES}
            and cgroup_state(unit) == expected["cgroup_state"])


def instances():
    result = subprocess.run(["/usr/bin/systemctl", "list-units", "--all", "--plain", "--no-legend", "--no-pager",
        "lit-incus-runtime-v2@*.service"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        env={"PATH": "/usr/bin:/bin", "LANG": "C"}, timeout=5, check=False)
    require(result.returncode == 0 and len(result.stdout) <= 16384)
    units = []
    for line in result.stdout.decode().splitlines():
        unit = line.split()[0]
        require(unit.startswith("lit-incus-runtime-v2@") and unit.endswith(".service") and len(unit) <= 255
                and unit not in units)
        units.append(unit)
    return set(units)


def inactive(history=None):
    expected = terminal_history({} if history is None else history)
    require(not os.path.lexists(SOCKET))  # Foreign/stale socket is never removed/adopted.
    for unit in ("lit-incus-runtime-v2.socket", "lit-incus-runtime-v2@.service",
                 "lit-incus-operating-watchdog.service", "lit-incus-operating-watchdog.timer",
                 "lit-incus-operating-mail.service", "lit-incus-operating-mail.timer"):
        state(unit)
    units = instances()
    if expected:
        require(units == set(expected))
    for unit in units:
        state(unit, expected.get(unit))
    if expected:
        require(instances() == units and terminal_history(history) == expected)


def canonical(value):
    return json.dumps(value,sort_keys=True,separators=(",",":"),allow_nan=False).encode()


def retired_preparation(runtime, config_digest, state, state_raw, reference):
    """Code-only migration of one separately retired partial; never a new lease.

    The Root-held cold controller must independently re-collect the complete
    history and resource absence before and after its operation. This reader
    binds that immutable qualification to the actual unchanged bank/files;
    it does not replace fresh controller admission or permit active work.
    """
    require(type(reference) is dict and set(reference) == {"path","sha256"}
            and reference["sha256"] == NINTH_RETIREMENT_SHA256)
    raw = sealed(reference["path"],reference["sha256"])
    value = decode(raw)
    require(canonical(value) == raw and type(value.get("schema")) is int and value["schema"] == 9
            and value.get("purpose") == "g06-ninth-failed-partial-separate-retirement-complete-history")
    retired = value["retirement"]
    require(type(retired["schema"]) is int and retired["schema"] == 1
            and retired["kind"] == "original-ninth-partial-separately-retired-unknown-preserved")
    original = retired["original_bootstrap"]
    require(original["sha256"] == config_digest
            and decode(sealed(original["path"],original["sha256"])) == runtime)
    bank, expected = retired["original_bank"], retired["original_record"]
    store = runtime["ledger_path"]
    require(type(bank) is dict and set(bank) == {"path","device","inode","state_file_sha256"}
            and bank["path"] == store and all(type(bank[k]) is int and bank[k] > 0 for k in ("device","inode"))
            and type(expected["lease_id"]) is str and set(state["leases"]) == {expected["lease_id"]})
    fd = directory(store)
    try:
        before = os.fstat(fd)
        require((before.st_dev,before.st_ino) == (bank["device"],bank["inode"]))
        require(sealed(store+"/state.json",bank["state_file_sha256"]) == state_raw)
        row = state["leases"][expected["lease_id"]]
        require(row["state"] == expected["state"] == "prepared" and "owned_instance" not in row
                and hashlib.sha256(canonical(row)).hexdigest() == expected["sha256"]
                and len(row["effects"]) == 8 and set(row["effects"]) == set(expected["effects"]))
        projection = {key:{"operation":effect["operation"],"state":effect["state"],
                          "effect_sha256":hashlib.sha256(canonical(effect)).hexdigest()}
                      for key,effect in row["effects"].items()}
        require(canonical(projection) == canonical(expected["effects"])
                and [(key,e["operation"],e["state"])for key,e in row["effects"].items()if e["state"] != "verified"]
                    == [(expected["unknown_effect_id"],"fence-create","unknown")]
                and not any(e["operation"] == "engine-start"for e in row["effects"].values()))
        terminal, native = row["native_terminal"], value["native_ninth"]
        jobs = [j for j in native["jobs"] if j["id"] == terminal["job_id"]]
        require(len(jobs) == 1 and jobs[0]["id"] == terminal["check_run_id"]
                and jobs[0]["status"] == native["run"]["status"] == "completed"
                and jobs[0]["conclusion"] == terminal["conclusion"] == native["run"]["conclusion"] == "failure"
                and terminal["source_sha"] == native["run"]["head_sha"] == row["identity"]["caller_sha"]
                and terminal["controller_sha"] == runtime["source_identity"]["reusable_sha"]
                and terminal["run_id"] == native["run"]["id"] == row["identity"]["run_id"]
                and type(terminal["run_attempt"]) is int and terminal["run_attempt"] == native["run"]["run_attempt"] == 1)
        from datetime import datetime
        import time
        completed = int(datetime.fromisoformat(jobs[0]["completed_at"].replace("Z","+00:00")).timestamp())
        policy = state["policies"][row["policy_sha256"]]
        require(type(terminal["completed_at"]) is int and terminal["completed_at"] == completed
                and type(retired["retain_until"]) is int and retired["retain_until"] == completed+14400 <= time.time()
                and type(policy["retention_seconds"]) is int and policy["retention_seconds"] == 14400
                and hashlib.sha256(canonical(policy)).hexdigest() == row["policy_sha256"])
        journals = {}
        native_members = {stem+suffix for stem in ("bridge-delete","descriptor-unlink","namespace-alias-unlink",
                          "private-tree-0","private-tree-1","private-tree-2","private-tree-3","project-delete")
                          for suffix in ("-intent.json","-receipt.json")} | {"complete-receipt.json"}
        for label,names in (("native_journal",native_members),
                            ("prior_journal",{"namespace-mount88-intent.json","namespace-mount88-unknown.json"})):
            journal = retired[label]
            require(type(journal) is dict and set(journal) == {"path","members"}
                    and set(journal["members"]) == names)
            handle = directory(journal["path"])
            try:
                require(set(os.listdir(handle)) == names)
                bodies = {}
                for leaf,digest in journal["members"].items():
                    body = sealed(journal["path"]+"/"+leaf,digest)
                    parsed = decode(body)
                    require(canonical(parsed)+b"\n" == body)
                    bodies[leaf] = parsed
                require(set(os.listdir(handle)) == names)
                journals[label] = bodies
            finally:
                os.close(handle)
        complete = journals["native_journal"]["complete-receipt.json"]
        require(complete["retention_deadline"] == retired["retain_until"]
                and type(complete["at"]) in {int,float} and complete["at"] >= retired["retain_until"]
                and complete["original_unknown_resolved"] is False
                and complete["prior_retirement_unknown_preserved"] is True
                and complete["native_case_acceptance"] is False
                and all(complete[k] is True for k in ("all_original_paths_absent","own_project_bridge_absent",
                                                      "owned_namespace_alias_mounts_absent")))
        for label in ("certificate_receipt","veth_receipt"):
            ref = retired[label]
            body = sealed(ref["path"],ref["sha256"])
            receipt = decode(body)
            require(canonical(receipt)+b"\n" == body and receipt["original_unknown_resolved"] is False
                    and receipt["metadata"]["lease_id"] == expected["lease_id"]
                    and receipt["metadata"]["original_record_sha256"] == expected["sha256"])
        require(sealed(store+"/state.json",bank["state_file_sha256"]) == state_raw
                and (os.fstat(fd).st_dev,os.fstat(fd).st_ino) == (before.st_dev,before.st_ino)
                and sealed(reference["path"],reference["sha256"]) == raw)
        reopened = directory(store)
        try:
            current = os.fstat(reopened)
            require((current.st_dev,current.st_ino) == (before.st_dev,before.st_ino)
                    == (bank["device"],bank["inode"]))
        finally:
            os.close(reopened)
    finally:
        os.close(fd)


def configurations(path, digest, group, public_pin=None, retired_reference=None):
    runtime = decode(sealed(path,digest))
    require(type(runtime["schema"]) is int)
    bootstrap = runtime["schema"] == 1
    if bootstrap:
        require(set(runtime) == {"schema", "source_identity", "source_workflow_sha256", "collector", "ledger_path",
                "custody_policy_sha256", "controller", "preparation", "runtime", "capacity", "cells"}
                | ({"operating_continuation"} if "operating_continuation" in runtime else set()))
        prep, collector, store = runtime["preparation"], runtime["collector"], runtime["ledger_path"]
        require(type(public_pin) is str and SHA.fullmatch(public_pin)
                and public_pin == prep["signing_public_key_hex"])
    else:
        require(runtime["schema"] == 2 and public_pin in {None, ""})
        registry = decode(sealed(runtime["registry_path"],runtime["registry_sha256"]))
        prep = decode(sealed(runtime["preparation_config_path"],runtime["preparation_config_sha256"]))
        require(prep["registry_path"] == runtime["registry_path"] and prep["registry_sha256"] == runtime["registry_sha256"])
        require(registry["api_read_token_path"] is None and 1 <= len(registry["cells"]) <= 2)
        collector, store = registry["collector"], registry["ledger_path"]
    service = collector["service"]
    account, selected_group = pwd.getpwnam(service["service_user"]), grp.getgrnam(group)
    require(account.pw_uid > 0 and selected_group.gr_gid > 0 and account.pw_gid == selected_group.gr_gid
            and service["installation"]["service_uid"] == account.pw_uid)
    require(not any(row.pw_name != account.pw_name and row.pw_gid == account.pw_gid for row in pwd.getpwall())
            and set(selected_group.gr_mem) <= {account.pw_name})
    memberships = set(os.getgrouplist(account.pw_name,account.pw_gid))
    for forbidden in ("root","sudo","docker","incus","incus-admin"):
        try:
            require(grp.getgrnam(forbidden).gr_gid not in memberships)
        except KeyError:
            pass
    for pathkey, hashkey in (("profile_path","profile_sha256"),("config_path","config_sha256")):
        sealed(collector[pathkey],collector[hashkey],private=pathkey == "config_path")
    sealed(service["fragment_path"],service["fragment_sha256"],private=False)
    sealed(service["installation"]["manifest_path"])
    for dropin in service["dropins"]:
        sealed(dropin["path"],dropin["sha256"],private=False)
    if not bootstrap:
        for cell in registry["cells"].values():
            body = decode(sealed(cell["cell_config_path"],cell["cell_sha256"]))
            pin = body["incus"]["server_certificate"]
            sealed(pin["path"],pin["sha256"])
    for key in ("network_fence_policy", "host_api_fence_policy", "storage_quota_policy"):
        decode(sealed(prep[key+"_path"],prep[key+"_sha256"]))
    private_metadata(prep["signing_key_path"])
    lock = sealed(prep["lock_path"])
    require(lock == b"")
    marker = decode(sealed(store+"/.initialized"))
    state_raw = sealed(store+"/state.json")
    state = decode(state_raw)
    sealed(store+"/lock")
    require(state["version"] == marker["version"] == 1 and state["store_id"] == marker["store_id"]
            and type(state["leases"]) is dict)
    original = {key:value for key,value in state.items() if key != "checksum"}
    require(state["checksum"] == hashlib.sha256(json.dumps(original,sort_keys=True,separators=(",",":"),allow_nan=False).encode()).hexdigest())
    require(retired_reference is None or type(retired_reference) is dict)
    if retired_reference:
        require(bootstrap)
        retired_preparation(runtime,digest,state,state_raw,retired_reference)
    else:
        require(all(row["state"] == "closed" for row in state["leases"].values()))
    return runtime


def installed_files(module_pins, client_pins, desired, complete):
    fd = directory(PRIVATE,missing=not complete)
    if fd is not None:
        try:
            require(stat.S_IMODE(os.fstat(fd).st_mode) == 0o700
                    and set(os.listdir(fd)) <= {"incus_lease_issuer"}
                    | {PurePosixPath(path).name for path in desired if str(PurePosixPath(path).parent) == PRIVATE})
        finally:
            os.close(fd)
    package = PRIVATE+"/incus_lease_issuer"
    fd = directory(package,missing=not complete)
    if fd is not None:
        try:
            require(stat.S_IMODE(os.fstat(fd).st_mode) == 0o700 and set(os.listdir(fd)) == set(module_pins))
        finally:
            os.close(fd)
        for name,digest in module_pins.items():
            require(re.fullmatch(r"[_a-z][_a-z0-9]*\.py",name))
            sealed(package+"/"+name,digest)
    for name,digest in client_pins.items():
        target = PUBLIC+"/"+name
        if complete or os.path.lexists(target):
            sealed(target,digest,private=False)
    for target,digest in desired.items():
        if complete or os.path.lexists(target):
            sealed(target,digest,private=target.startswith(PRIVATE) or target.endswith("-anchor.json")
                   or target.startswith("/usr/local/lib/lightning-it/incus-operating-mail-helper/"))


HELPERS = frozenset({"ephemeral_worker_local_mail.py", "ephemeral_worker_alarm.py", "ephemeral_worker_incus.py",
                     "ephemeral_worker_lease.py", "ephemeral_worker_watchdog.py", "ephemeral_worker_admission.py"})
HELPER_ROOT = "/usr/local/lib/lightning-it/incus-operating-mail-helper"
BINDINGS_ROOT = "/var/lib/lightning-it/incus-operating-bindings"


def operating_configuration(value, complete=False):
    """Read-only bindings; never tick, submit mail, create a lease or activate units."""
    require(type(value) is dict and set(value) in (
                {"watchdog_path", "watchdog_sha256", "mail_path", "mail_sha256", "helper_sha256"},
                {"watchdog_path", "watchdog_sha256", "mail_path", "mail_sha256", "helper_sha256", "retired_preparation"})
            and type(value["helper_sha256"]) is dict and set(value["helper_sha256"]) == HELPERS)
    if "retired_preparation" in value:
        require(type(value["retired_preparation"]) is dict
                and set(value["retired_preparation"]) == {"path","sha256"})
    for digest in value["helper_sha256"].values():
        require(type(digest) is str and SHA.fullmatch(digest))
    configs = []
    for label, extra in (("watchdog", {"bindings_directory", "max_entries"}), ("mail", {"helper_sha256"})):
        raw = sealed(value[label+"_path"],value[label+"_sha256"])
        config = decode(raw)
        require(type(config) is dict and set(config) == {"schema", "source_machine_id", "source_boot_id", "spool_directory"} | extra
                and type(config["schema"]) is int and config["schema"] == 1
                and json.dumps(config,sort_keys=True,separators=(",",":"),allow_nan=False).encode() == raw)
        require(config["source_machine_id"] == sealed("/etc/machine-id",private=False).decode("ascii").strip())
        # procfs boot_id is a kernel-provided regular Root file with a reported size of zero.
        fd = os.open("/proc/sys/kernel/random/boot_id", os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            require(os.fstat(fd).st_uid == 0)
            require(config["source_boot_id"] == os.read(fd,128).decode("ascii").strip())
        finally:
            os.close(fd)
        for key in ({"spool_directory", "bindings_directory"} if label == "watchdog" else {"spool_directory"}):
            fd = directory(config[key])
            try:
                require(stat.S_IMODE(os.fstat(fd).st_mode) == 0o700)
            finally:
                os.close(fd)
        if label == "watchdog":
            require(config["bindings_directory"] == BINDINGS_ROOT)
            require(type(config["max_entries"]) is int and 1 <= config["max_entries"] <= 256)
        else:
            require(config["helper_sha256"] == value["helper_sha256"])
        configs.append(config)
    require(configs[0]["spool_directory"] == configs[1]["spool_directory"])
    fd = directory(HELPER_ROOT,missing=not complete)
    if fd is not None:
        try:
            require(stat.S_IMODE(os.fstat(fd).st_mode) == 0o700 and set(os.listdir(fd)) == HELPERS)
        finally:
            os.close(fd)
        for name,digest in value["helper_sha256"].items():
            sealed(HELPER_ROOT+"/"+name,digest)
    if complete:
        from incus_lease_issuer import operating_local_mail
        # Verify the actual local-only MTA without sending or consuming an event.
        operating_local_mail._local_only(operating_local_mail._helpers(value["helper_sha256"]))
    return configs


def main():
    try:
        require(os.geteuid() == 0 and len(sys.argv) in {8,9,10,11})
        phase,config_path,digest,group = sys.argv[1:5]
        require(phase in {"before","after"})
        module_pins,client_pins,desired = map(decode,sys.argv[5:8])
        require(module_pins and set(client_pins) == {"incus-runtime-client","incus_job_client.py"})
        history = decode(sys.argv[10]) if len(sys.argv) == 11 else {}
        inactive(history)
        public_pin = sys.argv[8] if len(sys.argv) >= 9 else None
        operating = decode(sys.argv[9]) if len(sys.argv) >= 10 else None
        if operating is not None:
            operating_configuration(operating)
        config = configurations(config_path,digest,group,public_pin,
                                operating.get("retired_preparation") if operating is not None else None)
        for path in (PRIVATE,PUBLIC,"/etc/lit/incus-lease-issuer","/etc/lightning-it",
                     "/run/lightning-it/incus-runtime-v2","/etc/systemd/system","/usr/lib/tmpfiles.d"):
            fd=directory(path,missing=True)
            if fd is not None:os.close(fd)
        installed_files(module_pins,client_pins,desired,phase == "after")
        import cryptography
        require(tuple(map(int,cryptography.__version__.split(".")[:2])) >= (41,0))
        if phase == "after":
            sys.dont_write_bytecode=True
            sys.path.insert(0,PRIVATE)
            if config["schema"] == 1:
                from incus_lease_issuer.run_factory import load_bootstrap
                selected = load_bootstrap(config_path,digest)
                require(selected.value["preparation"]["signing_public_key_hex"] == public_pin)
                client = decode(sealed("/etc/lightning-it/incus-runtime-client.json",private=False))
                require(client == {"schema":2,"socket_path":SOCKET,"signing_public_key_hex":public_pin})
            else:
                from incus_lease_issuer.runtime_rpc import RuntimeRPC
                dispatcher = RuntimeRPC(config_path,digest)
                from incus_lease_issuer import preparation
                root = preparation._config(dispatcher._config.preparation_config_path,
                                           dispatcher._config.preparation_config_sha256)[0]
                private_metadata(root.signing_key_path)
        if operating is not None and phase == "after":
            operating_configuration(operating,complete=True)
        print("runtime-v2-disabled-installation-validated")
        return 0
    except Exception:
        print("runtime-v2-installation-denied",file=sys.stderr)
        return 1


if __name__ == "__main__":raise SystemExit(main())
