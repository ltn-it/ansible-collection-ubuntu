[Unit]
Description=Confirm local Root delivery of pending disposable worker alarms
After=local-fs.target postfix.service

[Service]
Type=oneshot
User=root
# The prepared Postfix queue group avoids a new SGID privilege gain under NNP.
Group=postdrop
ExecStart=/usr/bin/python3 -I -B {{ github_runner_ephemeral_local_mail_program_directory }}/ephemeral_worker_local_mail_entry.py --state-directory {{ github_runner_ephemeral_watchdog_state_directory }} --machine-id {{ github_runner_ephemeral_watchdog_machine_id }}
UMask=0077
TimeoutStartSec=20
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
InaccessiblePaths=-/var/lib/incus -/run/docker.sock -/run/podman -/var/snap/lxd
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
ReadWritePaths={{ github_runner_ephemeral_watchdog_state_directory }} /var/spool/postfix/maildrop
MemoryMax=128M
TasksMax=16
CPUQuota=25%
