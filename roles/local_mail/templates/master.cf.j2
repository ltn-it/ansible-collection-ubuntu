# No inet listeners and no smtp/lmtp outbound transport.
pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
showq     unix  n       -       n       -       1       showq
rewrite   unix  -       -       n       -       1       trivial-rewrite
bounce    unix    -    -    n    -    0    bounce
defer    unix    -    -    n    -    0    bounce
trace    unix    -    -    n    -    0    bounce
local     unix  -       n       n       -       1       local
error     unix  -       -       n       -       1       error
retry     unix  -       -       n       -       1       error
