# Owned by lit.ubuntu.local_mail: local mailbox pilot only.
compatibility_level = 3.6
myhostname = localhost.localdomain
mydomain = localhost
myorigin = localhost
mydestination = localhost, localhost.localdomain
inet_interfaces = 127.0.0.1
inet_protocols = ipv4
mynetworks = 127.0.0.1/32
default_transport = error:external delivery disabled
relay_transport = error:external delivery disabled
relayhost =
transport_maps =
virtual_alias_maps =
alias_maps =
alias_database =
forward_path =
mailbox_command =
mailbox_transport =
home_mailbox =
mail_spool_directory = /var/mail
local_recipient_maps = unix:passwd.byname
allow_mail_to_commands =
allow_mail_to_files =
disable_vrfy_command = yes
default_process_limit = 4
local_destination_concurrency_limit = 1
message_size_limit = 1048576
mailbox_size_limit = 16777216
maximal_queue_lifetime = 1h
bounce_queue_lifetime = 1h
