#!/usr/sbin/nft -f
# Managed by lit.ubuntu.host_firewall. Local changes are overwritten.
# Policy schema: lit.host_firewall.policy/v5
# Mode: {{ host_firewall_mode }}
# Policy fingerprint: {{ host_firewall_policy_fingerprint }}

# Replacing only the role-owned table keeps foreign and container-runtime tables intact.
destroy table {{ host_firewall_table_family }} {{ host_firewall_table_name }}

table {{ host_firewall_table_family }} {{ host_firewall_table_name }} {
    set host_ipv4_addresses {
        type ipv4_addr
        elements = { {{ host_firewall_host_ipv4_addresses_effective | join(', ') }} }
    }
{% for function in host_firewall_management_access | dict2items %}
{% if function.value.sources_ipv4 | length > 0 %}

    set {{ function.key }}_sources_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ function.value.sources_ipv4 | join(', ') }} }
    }
{% endif %}
{% endfor %}
{% for function in host_firewall_public_service_access | dict2items %}
{% if function.value.sources_ipv4 | length > 0 %}

    set public_{{ function.key }}_sources_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ function.value.sources_ipv4 | join(', ') }} }
    }
{% endif %}
{% endfor %}
{% for function in host_firewall_container_service_access | dict2items %}

    set container_{{ function.key }}_sources_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ function.value.sources_ipv4 | join(', ') }} }
    }

    set container_{{ function.key }}_destinations_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ function.value.destinations_ipv4 | join(', ') }} }
    }
{% endfor %}
{% if host_firewall_tang_access.sources_ipv4 | length > 0 %}

    set tang_sources_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ host_firewall_tang_access.sources_ipv4 | join(', ') }} }
    }
{% endif %}
{% if host_firewall_forward_proxy_access.enabled %}

    set forward_proxy_clients_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ host_firewall_forward_proxy_access.sources_ipv4 | join(', ') }} }
    }
{% endif %}
{% if host_firewall_container_dns_access.enabled %}

    set container_dns_clients_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ host_firewall_container_dns_access.sources_ipv4 | join(', ') }} }
    }
{% endif %}

    set container_interfaces {
        type ifname
        elements = {
{% for interface in host_firewall_container_interfaces %}
            "{{ interface }}"{{ "," if not loop.last else "" }}
{% endfor %}
        }
    }

    chain input {
        type filter hook input priority {{ host_firewall_input_priority }}; policy drop;

        counter comment "lit-host-firewall policy={{ host_firewall_policy_fingerprint }} mode={{ host_firewall_mode }}"
        iifname "lo" accept
        ct state invalid drop
        meta nfproto ipv4 ct state { established, related } accept

        meta nfproto ipv4 icmp type {
            destination-unreachable,
            time-exceeded,
            parameter-problem
        } accept
        meta nfproto ipv4 icmp type echo-request limit rate 10/second burst 20 packets accept

{% for function in host_firewall_management_access | dict2items %}
{% if host_firewall_mode in function.value.modes %}
{% if function.value.sources_ipv4 | length > 0 %}
        iifname { "{{ host_firewall_public_interface }}", "{{ host_firewall_management_interface }}" } ip saddr @{{ function.key }}_sources_v4 ip daddr @host_ipv4_addresses tcp dport {{ function.value.port }} ct state new accept
{% endif %}
{% endif %}
{% endfor %}
{% for function in host_firewall_public_service_access | dict2items %}
{% if host_firewall_mode in function.value.modes %}
{% if function.value.sources_ipv4 | length > 0 %}
        iifname "{{ host_firewall_public_interface }}" ip saddr @public_{{ function.key }}_sources_v4 ip daddr {{ host_firewall_expected_public_ipv4 }} {{ function.value.protocol }} dport {{ function.value.port }} ct state new accept
{% endif %}
{% endif %}
{% endfor %}
{% if host_firewall_tang_access.sources_ipv4 | length > 0 %}

        iifname "{{ host_firewall_public_interface }}" ip saddr @tang_sources_v4 ip daddr {{ host_firewall_expected_public_ipv4 }} tcp dport {{ host_firewall_tang_access.port }} ct state new accept
{% endif %}
{% if host_firewall_forward_proxy_access.enabled %}

        iifname { {{ host_firewall_forward_proxy_access.interfaces | map('to_json') | join(', ') }} } ip saddr @forward_proxy_clients_v4 ip daddr {{ host_firewall_forward_proxy_access.destination_ipv4 }} tcp dport {{ host_firewall_forward_proxy_access.port }} ct state new accept
{% endif %}
{% for client in host_firewall_forward_proxy_client_access | dict2items %}
{% if host_firewall_mode in client.value.modes %}

        iifname "{{ client.value.interface }}" ip saddr {{ client.value.source_ipv4 }} ip daddr {{ client.value.destination_ipv4 }} tcp dport {{ client.value.port }} ct state new accept
{% endif %}
{% endfor %}
{% if host_firewall_container_dns_access.enabled %}

        iifname { {{ host_firewall_container_dns_access.interfaces | map('to_json') | join(', ') }} } ip saddr @container_dns_clients_v4 ip daddr {{ host_firewall_container_dns_access.destination_ipv4 }} udp dport 53 ct state new accept
        iifname { {{ host_firewall_container_dns_access.interfaces | map('to_json') | join(', ') }} } ip saddr @container_dns_clients_v4 ip daddr {{ host_firewall_container_dns_access.destination_ipv4 }} tcp dport 53 ct state new accept
{% endif %}
{% if host_firewall_container_ssh_guard_managed %}
{% for client in host_firewall_container_ssh_bindings | dict2items %}

        iifname {{ client.value.interface | to_json }} ip saddr {{ client.value.source_ipv4 }} ip daddr {{ client.value.destination_ipv4 }} tcp dport {{ client.value.port }} ct state new accept
{% endfor %}
{% endif %}
{% for client in host_firewall_container_dns_clients | dict2items %}

        iifname {{ client.value.interface | to_json }} ip saddr {{ client.value.source_ipv4 }} ip daddr {{ client.value.destination_ipv4 }} udp dport 53 ct state new accept
{% endfor %}

        counter drop
    }

    chain container_guard {
        # New container/application forwarding remains closed until a separately approved rule exists.
        counter drop
    }

    chain forward {
        # This later-priority guard is evaluated after an earlier Podman/Netavark accept verdict.
        type filter hook forward priority {{ host_firewall_forward_priority }}; policy drop;

        ct state invalid drop
{% if host_firewall_published_https_access.enabled and host_firewall_mode in host_firewall_public_service_access.https.modes %}
{% for endpoint in host_firewall_published_https_access.endpoints %}
        # Published HTTPS is bound to the original public socket AND its exact post-DNAT endpoint.
        iifname "{{ host_firewall_public_interface }}" oifname "{{ endpoint.interface }}" ip saddr @public_https_sources_v4 ip daddr {{ endpoint.ipv4 }} tcp dport 443 ct state { new, established } ct direction original ct status dnat ct original ip saddr @public_https_sources_v4 ct original ip daddr {{ host_firewall_expected_public_ipv4 }} ct original protocol tcp ct original proto-dst 443 accept
        iifname "{{ endpoint.interface }}" oifname "{{ host_firewall_public_interface }}" ip saddr {{ endpoint.ipv4 }} ip daddr @public_https_sources_v4 tcp sport 443 ct state established ct direction reply ct status dnat ct original ip saddr @public_https_sources_v4 ct original ip daddr {{ host_firewall_expected_public_ipv4 }} ct original protocol tcp ct original proto-dst 443 accept
        iifname "{{ host_firewall_public_interface }}" oifname "{{ endpoint.interface }}" ip daddr {{ endpoint.ipv4 }} meta nfproto ipv4 ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } ct state related ct status dnat ct original ip saddr @public_https_sources_v4 ct original ip daddr {{ host_firewall_expected_public_ipv4 }} ct original protocol tcp ct original proto-dst 443 accept
        iifname "{{ endpoint.interface }}" oifname "{{ host_firewall_public_interface }}" ip saddr {{ endpoint.ipv4 }} ip daddr @public_https_sources_v4 meta nfproto ipv4 ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } ct state related ct status dnat ct original ip saddr @public_https_sources_v4 ct original ip daddr {{ host_firewall_expected_public_ipv4 }} ct original protocol tcp ct original proto-dst 443 accept
{% endfor %}
{% endif %}
{% for function in host_firewall_container_service_access | dict2items %}
{% if host_firewall_mode in function.value.modes %}
        iifname { {{ function.value.interfaces | map('to_json') | join(', ') }} } ip saddr @container_{{ function.key }}_sources_v4 oifname "{{ function.value.destination_interface }}" ip daddr @container_{{ function.key }}_destinations_v4 {{ function.value.protocol }} dport {{ function.value.port }} ct state { new, established } accept
        iifname "{{ function.value.destination_interface }}" oifname { {{ function.value.interfaces | map('to_json') | join(', ') }} } meta nfproto ipv4 ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } ct state related ct original ip saddr @container_{{ function.key }}_sources_v4 ct original ip daddr @container_{{ function.key }}_destinations_v4 ct original protocol {{ function.value.protocol }} ct original proto-dst {{ function.value.port }} accept
        iifname "{{ function.value.destination_interface }}" ip saddr @container_{{ function.key }}_destinations_v4 oifname { {{ function.value.interfaces | map('to_json') | join(', ') }} } ip daddr @container_{{ function.key }}_sources_v4 {{ function.value.protocol }} sport {{ function.value.port }} ct state established accept
{% endif %}
{% endfor %}
        iifname "{{ host_firewall_management_interface }}" counter drop
        oifname "{{ host_firewall_management_interface }}" counter drop
        iifname @container_interfaces goto container_guard
        oifname @container_interfaces goto container_guard
        meta nfproto ipv4 ct state { established, related } accept
        counter drop
    }

    chain output {
        # Every egress capability is a separate fixed function. FQDN references are evidence only and never expand
        # into implicit runtime destinations.
        type filter hook output priority {{ host_firewall_output_priority }}; policy drop;

        oifname "lo" accept
        ct state invalid drop
        meta nfproto ipv4 ct state { established, related } accept
        meta nfproto ipv4 ip protocol icmp accept
{% if host_firewall_published_https_access.enabled and host_firewall_published_https_access.host_proxy and host_firewall_mode in host_firewall_public_service_access.https.modes %}
{% for endpoint in host_firewall_published_https_access.endpoints %}
        # Only the validated local Squid identity may follow public HTTPS DNAT back to this endpoint.
        meta skuid {{ ansible_facts.getent_passwd[host_firewall_forward_proxy_egress.owner_username][1] | int }} oifname "{{ endpoint.interface }}" ip daddr {{ endpoint.ipv4 }} tcp dport 443 ct state { new, established } ct direction original ct status dnat ct original ip daddr {{ host_firewall_expected_public_ipv4 }} ct original protocol tcp ct original proto-dst 443 accept
{% endfor %}
{% endif %}
{% if host_firewall_forward_proxy_egress.enabled %}
        meta skuid {{ ansible_facts.getent_passwd[host_firewall_forward_proxy_egress.owner_username][1] | int }} oifname "{{ host_firewall_forward_proxy_egress.interface }}" ip daddr { {{ host_firewall_forward_proxy_egress.destinations_ipv4 | join(', ') }} } tcp dport { {{ host_firewall_forward_proxy_egress.ports | join(', ') }} } ct state new accept
{% endif %}
{% for function in host_firewall_egress_policy.functions | dict2items %}
{% if function.value.enabled and host_firewall_mode in function.value.modes %}
{% if function.value.destinations_ipv4 | length > 0 %}
        oifname "{{ function.value.interface }}" ip daddr { {{ function.value.destinations_ipv4 | join(', ') }} } {{ function.value.protocol }} dport {{ function.value.port }} ct state new accept
{% endif %}
{% endif %}
{% endfor %}

        counter drop
    }
}
{% if host_firewall_container_ssh_guard_managed %}

{{ host_firewall_container_ssh_guard_content }}
{% endif %}
